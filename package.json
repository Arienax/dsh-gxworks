{
  "name": "dsh-gxworks",
  "version": "0.2.7",
  "description": "Read, generate and edit Mitsubishi PLC projects in DeepSeek Harness. Includes the GXWorks Agent MCP backend for Windows x64. GitHub project at https://github.com/Arienax/dsh-gxworks",
  "license": "Apache-2.0",
  "author": "Arienax",
  "homepage": "https://github.com/Arienax/dsh-gxworks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arienax/dsh-gxworks.git"
  },
  "icon": "icon.svg",
  "type": "module",
  "main": "./index.mjs",
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "launch/mcp-launch.mjs",
    "launch/generate-ladder.mjs",
    "launch/bundled-runtime.mjs",
    "runtime/backend.json",
    "runtime/GXWorks-Agent-MCP-windows-x64.zip",
    "runtime/README.md",
    "scripts/check-package.mjs",
    "skills/**/*.md",
    "skills/**/*.txt",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check launch/mcp-launch.mjs && node --test tests/*.test.mjs",
    "sync-skill": "node scripts/sync-skill.mjs",
    "prepack": "node scripts/check-package.mjs",
    "prepare-runtime": "node launch/bundled-runtime.mjs",
    "check-install": "node scripts/check-install.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "skill",
    "gxworks",
    "plc",
    "mitsubishi"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
