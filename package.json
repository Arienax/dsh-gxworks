{
  "name": "dsh-gxworks",
  "version": "0.4.2",
  "description": "Read, generate and edit Mitsubishi PLC projects in DeepSeek Harness. Includes the GXWorks Agent MCP backend for Windows x64. GitHub project at https://github.com/Arienax/dsh-gxworks Bundled GXWorks Agent 0.4.2 is licensed under AGPL-3.0.",
  "license": "AGPL-3.0",
  "author": "Arienax",
  "homepage": "https://github.com/Arienax/dsh-gxworks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arienax/dsh-gxworks.git"
  },
  "icon": "icon.svg",
  "type": "module",
  "main": "./index.mjs",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "client.mjs",
    "cordis.patch.yml",
    "launch/mcp-launch.mjs",
    "launch/generate-ladder.mjs",
    "launch/bundled-runtime.mjs",
    "runtime/backend.json",
    "runtime/README.md",
    "scripts/check-package.mjs",
    "skills/**/*.md",
    "skills/**/*.txt",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "LICENSES/Apache-2.0.txt"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check launch/mcp-launch.mjs && node --test tests/*.test.mjs",
    "sync-skill": "node scripts/sync-skill.mjs",
    "pack-runtime": "node scripts/pack-runtime.mjs",
    "prepack": "node scripts/check-package.mjs",
    "prepare-runtime": "node launch/bundled-runtime.mjs",
    "check-install": "node scripts/check-install.mjs"
  },
  "dependencies": {
    "@arienax/dsh-gxworks-runtime-part001": "0.4.2",
    "@arienax/dsh-gxworks-runtime-part002": "0.4.2",
    "@arienax/dsh-gxworks-runtime-part003": "0.4.2",
    "@arienax/dsh-gxworks-runtime-part004": "0.4.2",
    "@arienax/dsh-gxworks-runtime-part005": "0.4.2",
    "@arienax/dsh-gxworks-runtime-part006": "0.4.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "skill",
    "gxworks",
    "plc",
    "mitsubishi"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
